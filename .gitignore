# Large media — keep out of git
/production/hero-film/stills/
/production/hero-film/clips_v1/
/production/references/
/production/prototypes/Examples/
/production/prototypes/landing-scroll/assets/vid/
/brand/references/
*.mp4
*.mov
*.png
*.jpg
*.jpeg
*.webp
!/production/prototypes/landing-scroll/assets/logo*.png

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node
# No trailing slash: a worktree's node_modules is a symlink (a file), which
# `node_modules/` does not match — one was committed and a merge then emptied
# the real node_modules.
node_modules
dist/
.next/
build/
*.log

# Local development Postgres cluster (npm run db:start)
.pgdata/

# Env
.env
.env.*
!.env.example

# Nested git worktrees for parallel build sessions — each has its own
# checkout, node_modules and .pgdata; none of it belongs to this tree.
/laqta-worktrees/

# Web-optimised hero posters (generated from production/hero-film/stills/final_stills_4K by sips).
# ~3.8MB total; the 200MB 4K originals stay out.
!/public/hero/
!/public/hero/*.jpg
*.tsbuildinfo

# Playwright MCP scratch output
.playwright-mcp/

# Generated documents (certificates, invoices) — private, never committed
.documents/
/public/hero/vid
/.media/
# Studio uploads on the local (dev) driver: watermarked previews/posters
# published for the page. Masters and scans never land under public/.
/public/uploads/

# Agent worktrees (local only)
.claude/worktrees/
