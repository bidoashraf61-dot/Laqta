# ── Database ────────────────────────────────────────────────────────────────
# All parallel sessions should point at the SAME database in development.
# `npm run db:start` boots a local embedded Postgres on 5433 matching this URL.
DATABASE_URL="postgresql://laqta:laqta@localhost:5433/laqta?schema=public"

# ── Auth.js ─────────────────────────────────────────────────────────────────
AUTH_SECRET="change-me-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ── Phone OTP (KSA/Egypt) ───────────────────────────────────────────────────
# Leave the provider unset in development: OTP codes are printed to the server
# console instead of being sent. Never do this in production.
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID="LAQTA"

# ── Video & object storage: AWS S3 + CloudFront ─────────────────────────────
# Full setup: docs/tech/media-aws.md. Leave everything here empty in development:
# masters fall back to the honest local driver (downloads end on a 404 rather
# than pretending), and public media falls back to files under public/ — the
# hero film from public/hero/vid, previews from "/"-rooted keys, and anything
# keyed to the bucket simply shows its poster.
#
# Credentials: the AWS SDK default chain. On a server prefer an instance/task
# role; otherwise set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for an IAM user
# limited to the two buckets below. Never commit real values.
AWS_REGION=""                 # e.g. "eu-central-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Private: masters, clean editing proxies, album ZIPs. Never public; reached
# only through /api/download with a short-lived signed URL.
S3_MASTERS_BUCKET=""          # e.g. "laqta-masters"
S3_SIGNED_URL_TTL_SECONDS="900"
# Optional: sign master downloads with CloudFront instead of S3 presigning.
# All three or none. The key is the PEM private key of a CloudFront public key
# in a trusted key group; "\n" escapes are accepted on one line.
MASTERS_CDN_URL=""            # e.g. "https://dl.laqta.example"
CLOUDFRONT_KEY_PAIR_ID=""     # the CloudFront *public key* ID, e.g. "K2ABCDEF…"
CLOUDFRONT_PRIVATE_KEY=""

# Public: watermarked previews, posters, album trailers, the hero film.
S3_MEDIA_BUCKET=""            # e.g. "laqta-media" — used by `npm run media:upload`
# The CloudFront domain in front of S3_MEDIA_BUCKET. NEXT_PUBLIC_ because the
# hero and the grids are client components — it is inlined at BUILD time, so
# set it before `npm run build`. Unset: bucket keys resolve to nothing and
# pages keep their posters.
NEXT_PUBLIC_MEDIA_CDN_URL=""  # e.g. "https://media.laqta.example"

# Optional: an S3-compatible stand-in (MinIO/LocalStack) for development only.
S3_ENDPOINT=""
# Where `npm run media:previews` looks for masters before trying the bucket,
# and where the studio's local (dev) upload driver assembles them.
MEDIA_MASTERS_DIR=""          # default: .media/masters
# Studio upload caps (bytes). Masters need CORS on the masters bucket for the
# browser's presigned PUTs — see docs/tech/media-aws.md.
UPLOAD_MAX_CLIP_BYTES=""      # default: 21474836480 (20 GiB)
UPLOAD_MAX_DOCUMENT_BYTES=""  # default: 15728640 (15 MiB), release scans

# ── Search (Meilisearch) ────────────────────────────────────────────────────
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY=""

# ── Commerce ────────────────────────────────────────────────────────────────
VAT_RATE="0.15"
DEFAULT_CURRENCY="SAR"
PAYOUT_HOLD_DAYS="30"
MIN_PAYOUT_SAR="500"

# ── Site origin ─────────────────────────────────────────────────────────────
# Absolute links in email come from here — a background sender has no request
# to read a host from. Falls back to AUTH_URL.
SITE_ORIGIN="http://localhost:3000"

# ── Transactional email (Resend) ────────────────────────────────────────────
# Leave MAIL_PROVIDER empty in development: messages are printed to the server
# console and stay pending in the outbox (/admin/settings shows the count).
# All three of MAIL_PROVIDER, MAIL_API_KEY and MAIL_FROM must be set to send.
# The key lives in the environment only — never in code. Owner setup steps
# (domain verification, SPF / DKIM / DMARC): specs/mail.md.
# MAIL_PROVIDER: "resend"
# MAIL_API_KEY: re_… from resend.com/api-keys, "Sending access" to one domain
# MAIL_FROM: a verified-domain sender, e.g. "لقطة <orders@mail.laqta.sa>"
# MAIL_REPLY_TO: where buyers' and creators' replies land, e.g. hello@laqta.sa
# MAIL_OPERATOR_TO: the operator's inbox — review queue + contact form
#   (OPERATOR_EMAIL is still read as a fallback)
MAIL_PROVIDER=""
MAIL_API_KEY=""
MAIL_FROM=""
MAIL_REPLY_TO=""
MAIL_OPERATOR_TO=""

# ── Bank transfer details (quoted in the order-placed email) ────────────────
# With BANK_IBAN empty the email says the details follow by reply instead.
BANK_NAME=""
BANK_ACCOUNT_NAME=""
BANK_IBAN=""
BANK_SWIFT=""

# ── /contact (content/contact.ts) ───────────────────────────────────────────
# Each channel renders on /contact ONLY when set. Leave empty until the owner
# supplies the real value — never a placeholder.
NEXT_PUBLIC_CONTACT_WHATSAPP=""   # digits only, international, no + (e.g. 20XXXXXXXXXX)
NEXT_PUBLIC_CONTACT_EMAIL=""      # the published support address
CONTACT_COMPANY_NAME_AR=""
CONTACT_COMPANY_NAME_EN=""        # optional; falls back to the Arabic
CONTACT_ADDRESS_AR=""             # registered address in Egypt; \n for line breaks
CONTACT_ADDRESS_EN=""             # optional; falls back to the Arabic
CONTACT_CR_NUMBER=""              # commercial registration (السجل التجاري)
# Contact-form messages go to MAIL_OPERATOR_TO (above).

# ── Payments: Paymob (card + Apple Pay) ─────────────────────────────────────
# DORMANT until the secret key, public key, HMAC secret and at least one
# integration id are all set. While any is empty, checkout offers bank transfer
# only, exactly as before. NEVER put real keys in this file or in the repo —
# set them in the deployment's secret store. Owner checklist:
# specs/api/payments-paymob.md → "Owner setup in the Paymob dashboard".
#
# Region: Egypt accounts use https://accept.paymob.com; a KSA account uses
# https://ksa.paymob.com. Keys belong to one region — do not mix them.
PAYMOB_BASE_URL="https://accept.paymob.com"
# Dashboard → Settings → Account info. The secret key is server-only.
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
# Dashboard → Settings → Account info → HMAC. Verifies every callback.
PAYMOB_HMAC_SECRET=""
# Integration ids per method (Developers → Payment integrations). Each must be
# an integration that charges in PAYMOB_CURRENCY. Either form works; the
# per-method variables win over the list.
PAYMOB_INTEGRATION_IDS=""           # e.g. "card:1234567,apple_pay:7654321"
PAYMOB_INTEGRATION_ID_CARD=""
PAYMOB_INTEGRATION_ID_APPLE_PAY=""
# Must equal the order currency. Orders are priced in USD.
PAYMOB_CURRENCY="USD"
# The public origin. Paymob's callback and return URLs are built from it:
#   {SITE_ORIGIN}/api/payments/paymob   and   {SITE_ORIGIN}/checkout/return
# SITE_ORIGIN is set above; in production it must be the public https origin —
# Paymob cannot call localhost.

# ── Error monitoring: Sentry ────────────────────────────────────────────────
# INERT until a DSN is set: with both DSNs empty the SDK is disabled and sends
# nothing. Errors only — no tracing unless a rate below is set, and no session
# replay (no analytics/consent decision has been made). Emails, IPs, cookies,
# request bodies and query strings are scrubbed in lib/observability.ts before
# anything leaves. Owner setup: docs/tech/sentry.md.
SENTRY_DSN=""                       # server + edge runtimes
NEXT_PUBLIC_SENTRY_DSN=""           # browser; inlined at build time — rebuild after setting
SENTRY_ENVIRONMENT=""               # e.g. "production"; defaults to NODE_ENV
SENTRY_TRACES_SAMPLE_RATE=""        # 0–1; empty = 0 (errors only)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=""
# Source-map upload at build time — only when SENTRY_AUTH_TOKEN is set; the
# build passes without any of these. Keep the token in the CI secret store.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
