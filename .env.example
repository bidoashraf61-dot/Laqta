# ── Database ────────────────────────────────────────────────────────────────
# All parallel sessions should point at the SAME database in development.
# `npm run db:start` boots a local embedded Postgres on 5433 matching this URL.
DATABASE_URL="postgresql://laqta:laqta@localhost:5433/laqta?schema=public"

# ── Auth.js ─────────────────────────────────────────────────────────────────
AUTH_SECRET="change-me-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ── Phone OTP (KSA/Egypt) ───────────────────────────────────────────────────
# Leave the provider unset in development: OTP codes are printed to the server
# console instead of being sent. Never do this in production.
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID="LAQTA"

# ── Video & object storage: AWS S3 + CloudFront ─────────────────────────────
# Full setup: docs/media-aws.md. Leave everything here empty in development:
# masters fall back to the honest local driver (downloads end on a 404 rather
# than pretending), and public media falls back to files under public/ — the
# hero film from public/hero/vid, previews from "/"-rooted keys, and anything
# keyed to the bucket simply shows its poster.
#
# Credentials: the AWS SDK default chain. On a server prefer an instance/task
# role; otherwise set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for an IAM user
# limited to the two buckets below. Never commit real values.
AWS_REGION=""                 # e.g. "eu-central-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Private: masters, clean editing proxies, album ZIPs. Never public; reached
# only through /api/download with a short-lived signed URL.
S3_MASTERS_BUCKET=""          # e.g. "laqta-masters"
S3_SIGNED_URL_TTL_SECONDS="900"
# Optional: sign master downloads with CloudFront instead of S3 presigning.
# All three or none. The key is the PEM private key of a CloudFront public key
# in a trusted key group; "\n" escapes are accepted on one line.
MASTERS_CDN_URL=""            # e.g. "https://dl.laqta.example"
CLOUDFRONT_KEY_PAIR_ID=""     # the CloudFront *public key* ID, e.g. "K2ABCDEF…"
CLOUDFRONT_PRIVATE_KEY=""

# Public: watermarked previews, posters, album trailers, the hero film.
S3_MEDIA_BUCKET=""            # e.g. "laqta-media" — used by `npm run media:upload`
# The CloudFront domain in front of S3_MEDIA_BUCKET. NEXT_PUBLIC_ because the
# hero and the grids are client components — it is inlined at BUILD time, so
# set it before `npm run build`. Unset: bucket keys resolve to nothing and
# pages keep their posters.
NEXT_PUBLIC_MEDIA_CDN_URL=""  # e.g. "https://media.laqta.example"

# Optional: an S3-compatible stand-in (MinIO/LocalStack) for development only.
S3_ENDPOINT=""
# Where `npm run media:previews` looks for masters before trying the bucket.
MEDIA_MASTERS_DIR=""          # default: .media/masters

# ── Search (Meilisearch) ────────────────────────────────────────────────────
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY=""

# ── Commerce ────────────────────────────────────────────────────────────────
VAT_RATE="0.15"
DEFAULT_CURRENCY="SAR"
PAYOUT_HOLD_DAYS="30"
MIN_PAYOUT_SAR="500"
