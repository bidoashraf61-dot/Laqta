// Laqta (لقطة) — Arabic-first stock-footage marketplace.
//
// OWNED BY FOUNDATION (Brief 01). Other sessions must not edit this file —
// record schema requests in your own brief's "Schema requests" section.
//
// Two non-negotiables, both on OrderItem:
//   1. clipManifestSnapshot — the exact clips owned at purchase time, frozen.
//      Entitlement is NEVER computed from the live album.
//   2. licenceVersionId + frozen commission fields — licence terms and
//      commission rate are snapshotted at purchase and never recomputed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  buyer
  creator
  admin
}

enum UserStatus {
  active
  suspended
  pending_verification
}

enum BillingEntityType {
  individual
  business
}

enum CreatorStatus {
  pending
  approved
  suspended
  rejected
}

enum CreatorTier {
  standard // 35% platform take
  silver //  30% — SAR 50k lifetime
  gold //    25% — SAR 200k lifetime
}

enum AlbumStatus {
  draft
  in_review
  changes_requested
  live
  paused
  delisted
}

enum AlbumTier {
  mini
  standard
  pro
  signature
}

enum ClearanceStatus {
  full // releases + permits complete → "cleared for commercial use ✅"
  editorial_only
  pending
}

/// How the footage in an album was made.
///
/// Buyers care, and increasingly have to declare it: a brand running a paid
/// campaign in Saudi may need to disclose synthetic media, and an agency
/// briefing a client on "real Saudi locations" is making a factual claim. It
/// is therefore a property of the album, stated on the card, and never
/// inferred from the look of a frame.
enum AlbumOrigin {
  captured // filmed on location with a camera
  generated // made with generative tools
}

/// The shape the album was cut for. Denormalised onto the album like
/// `clipCount`, because a grid needs it before it has loaded a single clip.
enum AlbumOrientation {
  landscape // 16:9 and wider
  portrait // 9:16
  mixed // both, deliberately
}

enum ReleaseType {
  model
  property
  permit
}

enum ReleaseVerification {
  pending
  verified
  rejected
}

enum IngestStatus {
  uploaded
  probing
  transcoding
  ready
  failed
}

enum OrderStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum ReviewStatus {
  unassigned
  assigned
  in_progress
  approved
  changes_requested
  rejected
}

enum ReviewDecision {
  approve
  request_changes
  reject
}

enum CheckState {
  pending
  pass
  fail
  not_applicable
}

enum LedgerEntryType {
  sale
  refund
  adjustment
  payout
  withholding
}

enum PayoutStatus {
  requested
  approved
  processing
  paid
  failed
}

enum PayoutMethod {
  iban // Saudi / local bank transfer
  payoneer
  wise
}

enum DisputeType {
  dmca
  ip_claim
  takedown
  content_complaint
}

enum DisputeStatus {
  open
  investigating
  content_disabled
  resolved
  rejected
}

enum ZatcaStatus {
  not_reported
  reported
  cleared
  failed
}

enum TaxonomyKind {
  category
  location
  tag
  theme
}

enum PromoKind {
  percent
  fixed
}

enum CmsKind {
  blog_post
  help_article
  landing_copy
  legal
}

enum CmsStatus {
  draft
  published
  archived
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String?    @unique
  emailVerified DateTime?
  phone         String?    @unique
  phoneVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?
  /// Nationality, as an ISO 3166-1 alpha-2 code — "SA", "EG", "GB".
  ///
  /// A code rather than a display name, because the name has to be shown in
  /// whichever language the reader is using and a stored string can only ever
  /// be in one. Distinct from `billingAddress.country`, which is where an
  /// invoice is sent: a Saudi national billing a Dubai office is two different
  /// facts and the tax treatment follows the second.
  country       String?
  locale        String     @default("ar")
  role          Role       @default(buyer)
  status        UserStatus @default(active)

  // Business account — required for a compliant ZATCA tax invoice.
  billingEntityType BillingEntityType @default(individual)
  legalName         String?
  crNumber          String? // Commercial Registration
  vatNumber         String?
  billingAddress    Json? // { line1, line2, city, region, postalCode, country }

  // 2FA — mandatory for creator and admin.
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  creator         Creator?
  boards          Board[]
  cart            Cart?
  orders          Order[]
  entitlements    Entitlement[]
  downloads       Download[]
  reviewTasks     ReviewTask[]     @relation("ReviewTaskReviewer")
  verifiedRels    Release[]        @relation("ReleaseVerifier")
  auditLogs       AuditLog[]       @relation("AuditActor")
  impersonations  Impersonation[]  @relation("ImpersonationAdmin")
  impersonated    Impersonation[]  @relation("ImpersonationTarget")
  disputes        Dispute[]        @relation("DisputeAssignee")
  footageRequests FootageRequest[]
  albumReviews    AlbumReview[]
  cmsEntries      CmsEntry[]       @relation("CmsAuthor")
  comps           CompDownload[]

  @@index([role, status])
}

// Auth.js adapter models.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Short-lived phone OTP challenge. Codes are hashed, never stored in clear.
model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Supply side
// ─────────────────────────────────────────────────────────────────────────────

model Creator {
  id            String        @id @default(cuid())
  userId        String        @unique
  handle        String        @unique
  displayNameAr String
  displayNameEn String
  bioAr         String?
  bioEn         String?
  showreelUrl   String?
  country       String        @default("EG") // ISO-3166-1 alpha-2
  /// Free text the creator types, so it is bilingual like every other display
  /// column rather than a lookup: a city we have no code for is still a city.
  cityAr        String?
  cityEn        String?
  status        CreatorStatus @default(pending)
  tier          CreatorTier   @default(standard)

  /// Per-creator override of the tier rate, as a fraction (0.30 = 30%).
  /// Null means "derive from tier". Admin-set only; see lib/commission.ts.
  commissionRateOverride Decimal? @db.Decimal(5, 4)

  isExclusive Boolean @default(false)

  /// The platform's own account — the licensor of record on the free sample
  /// album (`SampleAlbum`). Never a seller: it is created `suspended` so every
  /// public creator query (all of which filter `approved`) leaves it out, and
  /// `/admin/creators` filters it out by this flag. It earns nothing — a
  /// sample claim is a zero-value order and posts no ledger row.
  isHouse Boolean @default(false)

  // Payout rail. Foreign creators use payoneer/wise; KSA creators use IBAN.
  payoutMethod    PayoutMethod @default(iban)
  iban            String?
  bankName        String?
  beneficiaryName String?
  payoneerEmail   String?
  wiseEmail       String?
  taxResidency    String? // ISO country — drives withholding tax
  withholdingRate Decimal?     @db.Decimal(5, 4)
  taxFormOnFile   Boolean      @default(false)

  lifetimeGmv  Decimal @default(0) @db.Decimal(14, 2)
  balanceHeld  Decimal @default(0) @db.Decimal(14, 2)
  balanceAvail Decimal @default(0) @db.Decimal(14, 2)

  appliedAt   DateTime  @default(now())
  approvedAt  DateTime?
  suspendedAt DateTime?
  notes       String? // internal admin notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  albums     Album[]
  releases   Release[]
  ledger     CreatorLedger[]
  payouts    Payout[]
  orderItems OrderItem[]
  stats      AlbumStat[]

  @@index([status, tier])
}

model Album {
  id        String @id @default(cuid())
  slug      String @unique
  creatorId String

  titleAr       String
  titleEn       String
  descriptionAr String?
  descriptionEn String?

  status AlbumStatus @default(draft)
  tier   AlbumTier   @default(standard)

  priceStandard Decimal @db.Decimal(10, 2)
  /// The price this album is normally sold at, when it is currently on offer.
  /// NULL means "no offer" — it is deliberately not a discount percentage,
  /// because a percentage has to be recomputed to display and can drift from
  /// what was actually charged. The struck-through number a buyer sees is the
  /// number stored here, and `priceStandard` is always what they pay.
  /// A short cut of the album, shown large at the top of its page. NULL until
  /// one is produced — the page then leads with the cover still instead of an
  /// empty player, which is the difference between "no trailer yet" and
  /// "broken".
  ///
  /// A key in the public media bucket (`trailers/<slug>.mp4`), a "/"-rooted
  /// dev file, or a URL on the media CDN — resolved by `lib/media.ts`. Set by
  /// `/admin/catalogue` or `npm run media:upload`.
  trailerKey    String?

  compareAtPrice Decimal? @db.Decimal(10, 2)
  /// Short offer label, e.g. «عرض الإطلاق». NULL when compareAtPrice is NULL.
  /// Bilingual like every other display column: the English storefront shows an
  /// offer badge too, and a single-language column meant it read Arabic there.
  offerLabelAr   String?
  offerLabelEn   String?
  currency       String   @default("USD")

  coverClipId    String?
  /// UNUSED — superseded by `trailerKey`, which nothing reads alongside. Kept
  /// only because dropping a column is not an additive change on the shared
  /// dev database. Do not write it.
  trailerUrl     String?
  clipCount      Int     @default(0)
  totalRuntimeS  Int     @default(0)
  totalSizeBytes BigInt  @default(0)

  /// Stated on every card. Defaults to `captured` because that is what the
  /// launch catalogue is; a generated album has to say so explicitly.
  origin      AlbumOrigin      @default(captured)
  orientation AlbumOrientation @default(landscape)

  clearanceStatus ClearanceStatus @default(pending)
  isExclusive     Boolean         @default(false)

  /// Set by the review queue when every clip's releases and permits verify.
  /// Drives the buyer-facing "cleared for commercial use ✅" filter.
  clearedForCommercial Boolean @default(false)

  isFeatured  Boolean       @default(false)
  featureRank Int?
  publishedAt DateTime?
  delistedAt  DateTime?
  salesCount  Int           @default(0)
  ratingAvg   Decimal?      @db.Decimal(3, 2)
  /// Number of published reviews behind `ratingAvg`. Stored rather than
  /// counted on read: an average without its sample size is not a rating, it
  /// is a rumour — "5.0" from one buyer must not outrank "4.6" from ninety.
  ratingCount Int           @default(0)
  reviews     AlbumReview[]
  viewCount   Int           @default(0)

  /// Licence text in force. Frozen onto every OrderItem at purchase.
  licenceVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator        Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  licenceVersion LicenceVersion?   @relation(fields: [licenceVersionId], references: [id])
  clips          Clip[]
  taxonomy       AlbumTaxonomy[]
  collections    CollectionAlbum[]
  reviewTasks    ReviewTask[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  entitlements   Entitlement[]
  disputes       Dispute[]
  stats          AlbumStat[]
  /// Set only on the one house album that carries the free sample.
  sample         SampleAlbum?
  comps          CompDownload[]

  @@index([status, publishedAt])
  @@index([creatorId, status])
  @@index([isFeatured, featureRank])
}

model Clip {
  id         String @id @default(cuid())
  albumId    String
  orderIndex Int    @default(0)
  slug       String @unique

  titleAr       String
  titleEn       String
  descriptionAr String?
  descriptionEn String?

  // Technical metadata — extracted by FFmpeg probe at ingest, not typed by hand.
  durationS     Decimal @db.Decimal(8, 3)
  width         Int
  height        Int
  fps           Decimal @db.Decimal(6, 3)
  codec         String?
  bitrateKbps   Int?
  colourProfile String? // LOG / Rec.709 / RAW
  aspectRatio   String? // 16:9 / 9:16 / 1:1 / 2.39:1

  camera            String?
  lens              String?
  hasPeople         Boolean @default(false)
  identifiableFaces Boolean @default(false)
  cameraMovement    String? // Drone / Gimbal / Handheld / Static / Slider / Crane
  shotSize          String? // Wide / Medium / Close-up / Macro / Aerial
  timeOfDay         String?
  season            String?

  locationId String?
  geoLat     Decimal? @db.Decimal(9, 6)
  geoLng     Decimal? @db.Decimal(9, 6)

  // Object storage keys. Masters are never publicly addressable.
  masterKey     String?
  /// The CLEAN editing proxy a buyer downloads from their library. Private,
  /// in the masters bucket, reached only through `/api/download`. Never
  /// rendered on a public page — that is `previewKey`.
  proxyKey      String?
  /// The public, WATERMARKED 720p preview (`npm run media:previews`): a key in
  /// the media bucket served from the CDN, or a "/"-rooted dev file. Resolved
  /// by `lib/media.ts#mediaUrl`; NULL means the clip shows its poster.
  previewKey    String?
  previewHlsKey String?
  thumbnailKeys String[] @default([])
  spriteKey     String?

  checksum       String?
  /// Perceptual hash (64-bit dHash, hex). Drives duplicate / re-upload
  /// detection in the admin review queue.
  perceptualHash String?
  ingestStatus   IngestStatus @default(uploaded)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  album        Album          @relation(fields: [albumId], references: [id], onDelete: Cascade)
  location     Taxonomy?      @relation("ClipLocation", fields: [locationId], references: [id])
  taxonomy     ClipTaxonomy[]
  releaseLinks ReleaseClip[]
  boardClips   BoardClip[]
  downloads    Download[]
  sampleLinks  SampleClip[]
  comps        CompDownload[]

  @@index([albumId, orderIndex])
  @@index([perceptualHash])
  @@index([locationId])
}

model Release {
  id        String      @id @default(cuid())
  creatorId String
  type      ReleaseType

  fileKey         String
  subjectName     String? // model / property owner
  /// Issuing authority for permits — RCU (AlUla), Diriyah Gate, NEOM,
  /// Red Sea Global, GCAM, municipality, airport authority…
  authority       String?
  referenceNumber String?
  validFrom       DateTime?
  validTo         DateTime?
  notes           String?

  verification    ReleaseVerification @default(pending)
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator    Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  verifiedBy User?         @relation("ReleaseVerifier", fields: [verifiedById], references: [id])
  clipLinks  ReleaseClip[]

  @@index([creatorId, type, verification])
}

model ReleaseClip {
  releaseId String
  clipId    String

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  clip    Clip    @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@id([releaseId, clipId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Taxonomy — one table, discriminated by `kind`, so the admin taxonomy editor
// and the search synonym layer have a single surface to manage.
// ─────────────────────────────────────────────────────────────────────────────

model Taxonomy {
  id       String       @id @default(cuid())
  kind     TaxonomyKind
  parentId String?
  slug     String
  nameAr   String
  nameEn   String

  /// Search synonym layer. Arabic side carries morphological and
  /// hamza/alef variants; English side carries transliterations
  /// ("AlUla" ↔ "العلا"). Consumed by the Meilisearch index build.
  synonymsAr String[] @default([])
  synonymsEn String[] @default([])

  heroImage  String?
  seoTitleAr String?
  seoTitleEn String?
  seoDescAr  String?
  seoDescEn  String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent          Taxonomy?       @relation("TaxonomyTree", fields: [parentId], references: [id])
  children        Taxonomy[]      @relation("TaxonomyTree")
  albums          AlbumTaxonomy[]
  clips           ClipTaxonomy[]
  clipsAtLocation Clip[]          @relation("ClipLocation")

  @@unique([kind, slug])
  @@index([kind, parentId, sortOrder])
}

model AlbumTaxonomy {
  albumId    String
  taxonomyId String

  album    Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  taxonomy Taxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)

  @@id([albumId, taxonomyId])
}

model ClipTaxonomy {
  clipId     String
  taxonomyId String

  clip     Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  taxonomy Taxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)

  @@id([clipId, taxonomyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Merchandising
// ─────────────────────────────────────────────────────────────────────────────

model Collection {
  id            String  @id @default(cuid())
  slug          String  @unique
  titleAr       String
  titleEn       String
  descriptionAr String?
  descriptionEn String?
  heroMedia     String?
  isFeatured    Boolean @default(false)
  sortOrder     Int     @default(0)
  isPublished   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  albums CollectionAlbum[]
}

model CollectionAlbum {
  collectionId String
  albumId      String
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  album      Album      @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([collectionId, albumId])
}

/// Homepage / landing slots driven from /admin/merchandising.
model MerchandisingSlot {
  id         String    @id @default(cuid())
  key        String    @unique // hero, featured_albums, banner_top, locations_rail…
  titleAr    String?
  titleEn    String?
  subtitleAr String?
  subtitleEn String?
  mediaUrl   String?
  linkUrl    String?
  ctaLabelAr String?
  ctaLabelEn String?
  payload    Json? // slot-specific config (album ids, ordering…)
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  sortOrder  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Demand side
// ─────────────────────────────────────────────────────────────────────────────

model Board {
  id         String  @id @default(cuid())
  userId     String
  name       String
  isPublic   Boolean @default(false)
  shareToken String  @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips BoardClip[]

  @@index([userId])
}

model BoardClip {
  boardId String
  clipId  String
  addedAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  clip  Clip  @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@id([boardId, clipId])
}

model Cart {
  id     String @id @default(cuid())
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  albumId   String
  unitPrice Decimal @db.Decimal(10, 2)
  vatAmount Decimal @db.Decimal(10, 2)

  addedAt DateTime @default(now())

  cart  Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([cartId, albumId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  status      OrderStatus @default(pending)

  subtotal  Decimal @db.Decimal(12, 2)
  vatRate   Decimal @db.Decimal(5, 4)
  vatAmount Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
  currency  String  @default("USD")

  refundedAmount Decimal @default(0) @db.Decimal(12, 2)

  paymentMethod String? // mada / apple_pay / card / stc_pay / tabby / tamara / bank_transfer
  gatewayRef    String?

  /// Billing entity as it stood at purchase. Never re-read from User —
  /// the tax invoice must reflect what was agreed at the time.
  billingEntitySnapshot Json?
  poNumber              String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
  invoice    Invoice?
  refunds    Refund[]
  chargeback Chargeback?

  /// Every verified gateway callback that named this order.
  paymentEvents PaymentEvent[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// One verified server-to-server callback from a payment gateway (Paymob).
///
/// This is the idempotency key AND the audit trail. A callback is claimed by
/// inserting its row; a replay of the same transaction in the same state hits
/// the unique constraint and is acknowledged without doing anything. Only
/// callbacks whose HMAC verified are ever written — a forged request leaves no
/// row. `outcome` is what the handler decided:
///   settled | declined | pending | amount_mismatch | integration_mismatch |
///   already_paid | order_not_pending | unknown_order | reversed_at_gateway
model PaymentEvent {
  id            String   @id @default(cuid())
  gateway       String // 'paymob'
  transactionId String
  /// success | failed | pending | refunded | voided — part of the key, because
  /// Paymob re-sends the SAME transaction id when it is later refunded/voided.
  state         String
  orderId       String?
  outcome       String
  amountCents   Int?
  currency      String?
  payload       Json
  createdAt     DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([gateway, transactionId, state])
  @@index([orderId, createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  albumId   String
  creatorId String

  /// ── FROZEN AT PURCHASE ──────────────────────────────────────────────────
  /// Licence text version in force at purchase. Never repoint this.
  licenceVersionId String?

  grossAmount Decimal @db.Decimal(12, 2)
  vatAmount   Decimal @db.Decimal(12, 2)

  /// Commission rate as a fraction (0.35 = 35%), frozen at purchase.
  /// NEVER recompute from the creator's current tier — see lib/commission.ts.
  commissionRate   Decimal @db.Decimal(5, 4)
  commissionAmount Decimal @db.Decimal(12, 2)
  creatorNetAmount Decimal @db.Decimal(12, 2)

  /// Human-readable trace of how the rate was derived, for admin/audit:
  /// { tier, baseRate, exclusiveBonus, override, effectiveRate }
  commissionBasis Json?

  /// The exact clip IDs owned at purchase, with their titles and keys.
  /// Entitlement is served from this, never from the live album.
  clipManifestSnapshot Json
  /// ────────────────────────────────────────────────────────────────────────

  refundedAmount Decimal   @default(0) @db.Decimal(12, 2)
  refundedAt     DateTime?

  createdAt DateTime @default(now())

  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  album          Album               @relation(fields: [albumId], references: [id])
  creator        Creator             @relation(fields: [creatorId], references: [id])
  licenceVersion LicenceVersion?     @relation(fields: [licenceVersionId], references: [id])
  entitlement    Entitlement?
  certificate    LicenceCertificate?
  ledgerEntries  CreatorLedger[]
  refundLines    RefundLine[]

  @@index([creatorId, createdAt])
  @@index([albumId])
}

model Entitlement {
  id          String @id @default(cuid())
  userId      String
  albumId     String
  orderItemId String @unique

  /// Mirror of OrderItem.clipManifestSnapshot — the clips actually owned.
  clipIdsSnapshot String[] @default([])

  grantedAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokeReason String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  album     Album      @relation(fields: [albumId], references: [id])
  orderItem OrderItem  @relation(fields: [orderItemId], references: [id])
  downloads Download[]

  @@unique([userId, albumId])
  @@index([userId])
}

model Download {
  id            String  @id @default(cuid())
  entitlementId String
  userId        String
  clipId        String? // null = whole-album ZIP
  isAlbumZip    Boolean @default(false)
  ip            String?
  userAgent     String?
  bytes         BigInt  @default(0)

  createdAt DateTime @default(now())

  entitlement Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip        Clip?       @relation(fields: [clipId], references: [id])

  @@index([entitlementId, createdAt])
  @@index([userId, createdAt])
}

/// One watermarked-preview download — a "comp" — by a signed-in visitor.
///
/// Separate from `Download` on purpose: that table is the audit trail of a
/// PAID entitlement and every row carries one. A comp is free, pre-purchase,
/// and the opposite signal — someone testing an album in their own timeline
/// before deciding. Mixing the two would make "downloads" mean both.
///
/// Two jobs: the per-user rate limit counts these rows (`lib/previews.ts`),
/// and `/admin/catalogue` reads them per album as buying intent.
model CompDownload {
  id         String   @id @default(cuid())
  userId     String
  albumId    String
  /// null = the whole-album ZIP of previews.
  clipId     String?
  isAlbumZip Boolean  @default(false)
  /// How many preview files this download carried (1 for a clip).
  fileCount  Int      @default(1)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  clip  Clip? @relation(fields: [clipId], references: [id], onDelete: SetNull)

  @@index([userId, isAlbumZip, createdAt])
  @@index([albumId, createdAt])
}

/// Versioned licence text. OrderItem points at the version in force at
/// purchase; revising the text creates a new row, never an update.
///
/// There is ONE licence — full commercial — so there is no tier here. The
/// version is still frozen onto every order, because the text can change and a
/// buyer owns the wording that was in force when they paid.
model LicenceVersion {
  id        String  @id @default(cuid())
  version   String  @unique // e.g. "commercial-v1"
  titleAr   String
  titleEn   String
  bodyAr    String
  bodyEn    String
  isCurrent Boolean @default(false)

  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  albums     Album[]
  orderItems OrderItem[]
}

model LicenceCertificate {
  id                String   @id @default(cuid())
  orderItemId       String   @unique
  certificateNumber String   @unique
  pdfKey            String?
  issuedAt          DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

/// ZATCA Fatoora e-invoice.
model Invoice {
  id            String      @id @default(cuid())
  orderId       String      @unique
  invoiceNumber String      @unique
  uuid          String      @unique
  previousHash  String?
  qrCode        String?
  xmlKey        String?
  pdfKey        String?
  zatcaStatus   ZatcaStatus @default(not_reported)
  zatcaResponse Json?
  isManual      Boolean     @default(false) // raised by admin for enterprise/Net-30

  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Refunds & chargebacks
// ─────────────────────────────────────────────────────────────────────────────

model Refund {
  id      String @id @default(cuid())
  orderId String

  amount      Decimal @db.Decimal(12, 2)
  vatAmount   Decimal @db.Decimal(12, 2)
  reason      String
  /// Policy path taken: no_download_within_7d | technical_defect |
  /// discretionary | chargeback. Recorded because the policy is contested.
  policyBasis String
  isPartial   Boolean @default(false)

  processedById String?
  gatewayRef    String?

  createdAt DateTime @default(now())

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines RefundLine[]

  @@index([orderId])
}

model RefundLine {
  id          String @id @default(cuid())
  refundId    String
  orderItemId String

  grossAmount        Decimal @db.Decimal(12, 2)
  vatAmount          Decimal @db.Decimal(12, 2)
  /// Commission reversed using the FROZEN rate on the OrderItem.
  commissionReversed Decimal @db.Decimal(12, 2)
  creatorNetReversed Decimal @db.Decimal(12, 2)

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
}

model Chargeback {
  id      String @id @default(cuid())
  orderId String @unique

  amount     Decimal   @db.Decimal(12, 2)
  reasonCode String?
  status     String    @default("open") // open | represented | lost | won
  openedAt   DateTime  @default(now())
  dueBy      DateTime?
  resolvedAt DateTime?
  notes      String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Creator money
// ─────────────────────────────────────────────────────────────────────────────

model CreatorLedger {
  id        String          @id @default(cuid())
  creatorId String
  entryType LedgerEntryType

  /// Signed. Sales are positive; refunds, payouts and withholding negative.
  amount       Decimal @db.Decimal(14, 2)
  currency     String  @default("USD")
  balanceAfter Decimal @db.Decimal(14, 2)

  orderItemId String?
  payoutId    String?
  memo        String?

  /// Sale date + 30-day hold. Only entries past this date are payable.
  availableAt DateTime?

  createdAt DateTime @default(now())

  creator   Creator    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])
  payout    Payout?    @relation(fields: [payoutId], references: [id])

  @@index([creatorId, createdAt])
  @@index([creatorId, availableAt])
}

model Payout {
  id        String  @id @default(cuid())
  creatorId String
  runId     String?

  amount   Decimal      @db.Decimal(14, 2)
  currency String       @default("USD")
  status   PayoutStatus @default(requested)
  method   PayoutMethod

  /// Destination frozen at approval — bank details may change afterwards.
  destinationSnapshot Json?

  withholdingAmount Decimal @default(0) @db.Decimal(14, 2)
  netAmount         Decimal @db.Decimal(14, 2)

  reference   String?
  periodStart DateTime?
  periodEnd   DateTime?
  /// Creator self-billing invoice generated per payout.
  invoiceKey  String?

  approvedById  String?
  approvedAt    DateTime?
  paidAt        DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator Creator         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  run     PayoutRun?      @relation(fields: [runId], references: [id])
  ledger  CreatorLedger[]

  @@index([status, createdAt])
  @@index([creatorId, status])
}

model PayoutRun {
  id     String @id @default(cuid())
  label  String
  /// draft (lines editable, files downloadable) → paid (closed with the
  /// operator's reference) | void (every line excluded). See lib/payouts.ts.
  status String @default("draft")

  periodStart DateTime
  periodEnd   DateTime

  totalAmount Decimal @default(0) @db.Decimal(14, 2)
  payoutCount Int     @default(0)

  /// Generated export artefacts, keyed by rail: { iban: key, payoneer: key }
  exportKeys Json?

  approvedById String?
  approvedAt   DateTime?
  exportedAt   DateTime?

  /// The operator's external reference for the whole run (bank batch id,
  /// Wise batch id…), copied onto every payout it pays.
  reference String?
  paidAt    DateTime?
  paidById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payouts Payout[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Review queue — the operational heart
// ─────────────────────────────────────────────────────────────────────────────

model ReviewTask {
  id         String       @id @default(cuid())
  albumId    String
  reviewerId String?
  status     ReviewStatus @default(unassigned)

  /// Structured checklist, one row per check. See lib/review-checklist.ts for
  /// the canonical key list — stored as JSON so checks can be added without a
  /// migration, but always written through the helper.
  checklist Json?

  notes        String?
  /// Note sent to the creator on request-changes / reject.
  decisionNote String?
  decision     ReviewDecision?
  /// SLA target is 3 business days from submission.
  submittedAt  DateTime        @default(now())
  slaDueAt     DateTime?
  assignedAt   DateTime?
  startedAt    DateTime?
  decidedAt    DateTime?

  /// Snapshot of the automated reports at decision time.
  duplicateReport Json?
  technicalReport Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  album    Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewTaskReviewer", fields: [reviewerId], references: [id])

  @@index([status, slaDueAt])
  @@index([albumId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Pricing
// ─────────────────────────────────────────────────────────────────────────────

model PriceBand {
  id            String    @id @default(cuid())
  tier          AlbumTier @unique
  labelAr       String
  labelEn       String
  minClips      Int
  maxClips      Int?
  priceStandard Decimal   @db.Decimal(10, 2)
  /// Extended is 3× standard by policy; kept explicit so it can be tuned.
  currency      String    @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id       String    @id @default(cuid())
  code     String    @unique
  kind     PromoKind @default(percent)
  value    Decimal   @db.Decimal(10, 2)
  currency String    @default("USD")

  maxRedemptions Int?
  redemptions    Int      @default(0)
  minOrderTotal  Decimal? @db.Decimal(10, 2)
  /// Restrict to specific albums / collections; empty = everything.
  albumIds       String[] @default([])

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Disputes
// ─────────────────────────────────────────────────────────────────────────────

model Dispute {
  id      String        @id @default(cuid())
  type    DisputeType
  status  DisputeStatus @default(open)
  albumId String?

  claimantName    String
  claimantEmail   String
  claimantOrg     String?
  /// Sworn statement / good-faith declaration text for DMCA.
  statement       String
  evidenceKeys    String[] @default([])
  /// Free-text list of the specific clips complained of.
  affectedClipIds String[] @default([])

  assigneeId        String?
  resolution        String?
  contentDisabledAt DateTime?
  resolvedAt        DateTime?
  /// Counter-notice from the creator, if any.
  counterNotice     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  album    Album? @relation(fields: [albumId], references: [id])
  assignee User?  @relation("DisputeAssignee", fields: [assigneeId], references: [id])

  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Search telemetry — feeds the zero-result report, the single most valuable
// content-acquisition signal the business has.
// ─────────────────────────────────────────────────────────────────────────────

model SearchQueryLog {
  id          String   @id @default(cuid())
  query       String
  normalized  String
  locale      String   @default("ar")
  resultCount Int      @default(0)
  filtersJson Json?
  userId      String?
  sessionId   String?
  createdAt   DateTime @default(now())

  @@index([normalized, createdAt])
  @@index([resultCount, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Analytics — daily rollup, one row per album per day.
//
// Trend charts need time series, and computing them live from Order/Download
// on every dashboard load does not scale. This table is the aggregate: a job
// (or the checkout/download/view paths) increments the current day's row, and
// the dashboards read ranges straight out of it. `creatorId` is denormalised
// on so a creator's whole-catalogue trend is one indexed query rather than a
// join through Album.
// ─────────────────────────────────────────────────────────────────────────────

model AlbumStat {
  id        String   @id @default(cuid())
  albumId   String
  creatorId String
  /// Midnight (UTC) of the day this row aggregates.
  day       DateTime

  views     Int     @default(0)
  boardAdds Int     @default(0)
  cartAdds  Int     @default(0)
  purchases Int     @default(0)
  /// Gross sale value booked that day, ex-VAT.
  revenue   Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  album   Album   @relation(fields: [albumId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([albumId, day])
  @@index([creatorId, day])
  @@index([day])
}

// ─────────────────────────────────────────────────────────────────────────────
// CMS
// ─────────────────────────────────────────────────────────────────────────────

model CmsEntry {
  id     String    @id @default(cuid())
  kind   CmsKind
  slug   String
  status CmsStatus @default(draft)

  titleAr   String
  titleEn   String
  bodyAr    String?
  bodyEn    String?
  excerptAr String?
  excerptEn String?
  heroImage String?

  seoTitleAr String?
  seoTitleEn String?
  seoDescAr  String?
  seoDescEn  String?

  authorId    String?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User? @relation("CmsAuthor", fields: [authorId], references: [id])

  @@unique([kind, slug])
  @@index([kind, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String  @id @default(cuid())
  actorId   String?
  action    String // album.approve, order.refund, user.impersonate…
  entity    String // Album, Order, User…
  entityId  String?
  /// Before/after or free-form context.
  detail    Json?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}

/// Support impersonation. Every session is opened and closed explicitly and
/// is always audit-logged — required by the brief.
model Impersonation {
  id           String    @id @default(cuid())
  adminId      String
  targetUserId String
  reason       String
  ticketRef    String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  ip           String?

  admin  User @relation("ImpersonationAdmin", fields: [adminId], references: [id])
  target User @relation("ImpersonationTarget", fields: [targetUserId], references: [id])

  @@index([adminId, startedAt])
  @@index([targetUserId, startedAt])
}

/// A buyer asking for footage that does not exist yet.
///
/// This is the feature none of the Arabic competitors offer, and it only works
/// because the catalogue is generated rather than shot: a request for "الطائف
/// في الضباب" is a production job, not an expedition. It is also the cheapest
/// demand signal available — every row is a customer telling us what to build
/// next, with an address to notify when it lands.
model FootageRequest {
  id String @id @default(cuid())

  /// Free text, in the buyer's own words. Deliberately not a taxonomy pick:
  /// the value of this table is the phrasing we did not think of.
  briefAr      String
  /// Optional structured hints, when the buyer used the picker.
  locationSlug String?
  categorySlug String?

  /// Where to reply. Kept separate from User because most requests will come
  /// from people who have not signed up yet — requiring an account first is
  /// how you never hear the request.
  email  String
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status           FootageRequestStatus @default(open)
  /// Operator note — why it was declined, or which album fulfilled it.
  resolutionNote   String?
  /// Set when an album ships that answers this request.
  fulfilledAlbumId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

enum FootageRequestStatus {
  open
  planned
  fulfilled
  declined
}

/// A buyer's verdict on an album they actually own.
///
/// ── Why ownership is enforced, not encouraged ──────────────────────────────
/// A review carries weight only because the person writing it paid. The write
/// path checks for an `Entitlement` on the album; without one there is no
/// review, which makes review-bombing and competitor sabotage a purchase away
/// rather than a signup away. The unique constraint stops one buyer stacking
/// ten reviews on the same album.
///
/// ── Why it is moderated ────────────────────────────────────────────────────
/// Reviews are user text on a commercial page. `status` defaults to
/// `published` because a queue nobody empties silences honest buyers, but an
/// operator can hide one without deleting it — a deleted review is an argument
/// with a customer you cannot reconstruct.
model AlbumReview {
  id String @id @default(cuid())

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1–5. Enforced in the action, not by the database, so an invalid value
  /// returns a message rather than a 500.
  rating Int
  /// Optional. A star with no words is still a signal worth keeping.
  bodyAr String?

  status         AlbumReviewStatus @default(published)
  /// Why an operator hid it. Never shown to the public.
  moderationNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One verdict per buyer per album.
  @@unique([albumId, userId])
  @@index([albumId, status, createdAt])
}

enum AlbumReviewStatus {
  published
  hidden
}

/// Queued outbound mail.
///
/// ── Why a table and not a direct send ──────────────────────────────────────
/// A message must never be sent from inside the transaction that creates the
/// thing it describes, and a mail failure must never roll that thing back:
/// someone who paid owns what they bought whether or not a mail server was
/// reachable.
///
/// Rows are written in the SAME transaction as the order, the review decision
/// or the price. That makes "the thing happened" and "the email is owed"
/// atomic — the classic transactional outbox. A sender then drains the table
/// afterwards, and a failure is retryable and, crucially, *visible*: with one
/// person operating this platform, "which emails did not go out" has to be a
/// question the dashboard can answer.
model MailOutbox {
  id       String @id @default(cuid())
  /// Template name, e.g. 'order.confirmed'. A row value, never a schema change.
  template String
  toEmail  String

  /// Frozen at write time, NOT resolved when sending.
  ///
  /// The sender runs outside any request, so it has no locale header — and
  /// `t()` reads a store built on React's cache(), which only memoises inside a
  /// render. Resolving language at send time would answer every recipient in
  /// Arabic. See lib/locale-request.ts.
  locale String

  /// Ids and values the template needs. Never rendered copy — the wording is
  /// resolved at send time from messages/*.json so an edit reaches queued mail.
  payload Json

  /// Storage keys of documents to attach, resolved at send time.
  attachments String[] @default([])

  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?
  /// Set when the failure is permanent — a bounce is not a transient error and
  /// must not be retried until the attempt cap burns down.
  failedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([sentAt, failedAt, createdAt])
}

/// A message sent from the public /contact form.
///
/// Stored first, mailed second: the row is the record, and the email to the
/// operator is a courtesy that may fail (no provider is wired yet). A message
/// that only existed in a send nobody received would be a message lost.
model ContactMessage {
  id String @id @default(cuid())

  name    String
  /// Where to reply. No account required — most people who write have none.
  email   String
  /// One of the topic keys in content/contact.ts (buying, selling, custom,
  /// rights, other), or null when the visitor did not pick one.
  topic   String?
  message String
  /// The language the visitor wrote from, so the reply can answer in it.
  locale  String  @default("ar")

  status      ContactMessageStatus @default(open)
  handledAt   DateTime?
  handledById String?

  /// Whether the operator notification actually left. False with no mail
  /// provider configured — the admin list is then the only place it shows.
  mailDelivered Boolean @default(false)

  /// Salted SHA-256 of the sender's IP. Used only for the rate limit; the raw
  /// address is never stored.
  ipHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@index([email, createdAt])
}

enum ContactMessageStatus {
  open
  handled
}

/// The free sample album — owner decision 2026-09-24. Signed-in users only,
/// one claim each, made of clips the operator picks from live albums.
///
/// ── Why it hangs off a real Album row ──────────────────────────────────────
/// Orders, entitlements, certificates and the library are all keyed on an
/// album. Giving the sample its own house `Album` (creator = the house
/// `Creator`, status held at `draft` forever so no `status: 'live'` query can
/// ever list it) lets a claim travel the same frozen path as a purchase:
/// OrderItem + clipManifestSnapshot + Entitlement + LicenceCertificate,
/// settled by `settleOrder`. The unique `Entitlement(userId, albumId)` is the
/// one-claim-per-user rule.
///
/// Publication lives HERE, not in `Album.status` — see above.
model SampleAlbum {
  id          String    @id @default(cuid())
  albumId     String    @unique
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  album Album        @relation(fields: [albumId], references: [id])
  clips SampleClip[]
}

/// A clip chosen for the sample, from any live album. The clip stays in its
/// own album (`Clip.albumId`); this only points at it. What a claimant owns is
/// the manifest snapshotted at claim time, so removing a row here never takes
/// a clip back from anyone who already claimed.
model SampleClip {
  id         String   @id @default(cuid())
  sampleId   String
  clipId     String
  orderIndex Int      @default(0)
  addedAt    DateTime @default(now())

  sample SampleAlbum @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  clip   Clip        @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([sampleId, clipId])
  @@index([sampleId, orderIndex])
}
